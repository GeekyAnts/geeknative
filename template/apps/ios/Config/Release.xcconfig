#include "Base.xcconfig"

DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
ENABLE_NS_ASSERTIONS = NO
SWIFT_COMPILATION_MODE = wholemodule
VALIDATE_PRODUCT = YES

// The environment from contracts/config.json this build targets. Override with:
//   xcodebuild APP_ENVIRONMENT=staging ...
APP_ENVIRONMENT = production
// APP_ENV_<name> is what the generated AppEnvironment.current switches on.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = APP_ENV_$(APP_ENVIRONMENT) $(inherited)
