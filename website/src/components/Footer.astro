---
// Starlight's footer (edit link, pagination), plus a credit line on every page.
import Default from '@astrojs/starlight/components/Footer.astro'
---

<Default />
<p class="gn-credit">
  Built by <a href="https://geekyants.com">GeekyAnts</a>. Released under the
  <a href="https://github.com/GeekyAnts/geeknative/blob/main/LICENSE">Apache 2.0 license</a>.
</p>

<style>
  .gn-credit {
    margin-top: 2.5rem;
    text-align: center;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .gn-credit a {
    color: inherit;
  }
  .gn-credit a:hover {
    color: var(--sl-color-text-accent);
  }
</style>
