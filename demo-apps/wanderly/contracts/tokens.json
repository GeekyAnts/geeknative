    "title": { "size": 20, "lineHeight": 26, "weight": 600, "ios": "title3", "android": "titleLarge" },
    "body": { "size": 16, "lineHeight": 24, "weight": 400, "ios": "body", "android": "bodyLarge" },
    "label": { "size": 14, "lineHeight": 20, "weight": 500, "ios": "subheadline", "android": "labelLarge" },
    "caption": { "size": 12, "lineHeight": 16, "weight": 400, "ios": "caption", "android": "bodySmall" }
  },
  "font": {
    "family": "Outfit",
    "files": {
      "400": "Outfit-Regular.ttf",
      "500": "Outfit-Medium.ttf",
