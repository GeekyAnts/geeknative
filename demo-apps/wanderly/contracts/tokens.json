    "accent": { "light": "#B44A32", "dark": "#E8927A" },
    "onAccent": { "light": "#FFFFFF", "dark": "#2A120C" },
    "overlay": { "light": "#102117", "dark": "#07110C" },
    "onOverlay": { "light": "#FFFBF5", "dark": "#FFFBF5" },
