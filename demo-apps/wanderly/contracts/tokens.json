  "icon": {
    "sm": 16,
    "md": 24,
    "lg": 32
  },
  "size": {
    "touchTarget": 48,
    "thumb": 80,
    "cardImage": 200,
    "placeHero": 320,
    "hero": 360,
    "featured": 440
  },
  "motion": {
    "duration": { "fast": 150, "normal": 250, "slow": 350 },
    "easing": {
      "standard": [0.2, 0, 0, 1],
      "decelerate": [0, 0, 0, 1],
      "accelerate": [0.3, 0, 1, 1]
    },
    "spring": {
      "snappy": { "duration": 300, "bounce": 0.15 },
      "bouncy": { "duration": 400, "bounce": 0.3 }
    }
  },
  "elevation": {
    "low": { "y": 4, "blur": 16, "opacity": 0.12, "color": "overlay" },
