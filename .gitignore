node_modules/
.DS_Store

# Tripadvisor is a local app checkout. The showcase tracks its name, summary, and
# previews; the rest of that folder stays out of this repo.
demo-apps/tripadvisor/*
!demo-apps/tripadvisor/previews/
!demo-apps/tripadvisor/contracts/
!demo-apps/tripadvisor/PRODUCT.md
demo-apps/tripadvisor/contracts/*
!demo-apps/tripadvisor/contracts/app.json

# Bundled copy of template/, created only while packing
packages/geeknative/template/

# Build output and local state from developing the template in place
template/node_modules/
template/package-lock.json
template/.geeknative/logs/
template/apps/ios/.build/
template/apps/android/.gradle/
template/apps/android/.kotlin/
template/apps/android/build/
template/apps/android/app/build/
template/apps/android/local.properties

# Secrets: values from .env that gen inlines into the mobile apps
template/.env
template/apps/ios/App/Generated/AppSecrets.swift
template/apps/android/app/src/main/kotlin/app/generated/AppSecrets.kt
template/apps/web/.output/
template/apps/web/.tanstack/
template/apps/web/.nitro/
template/apps/web/dist/
xcuserdata/
*.xcuserstate
